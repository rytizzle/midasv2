DATABRICKS_HOST=https://fevm-midas.cloud.databricks.com
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_SERVING_ENDPOINT_NAME=databricks-gpt-5-4
DATABRICKS_GENIE_SPACE_ID=
DATABRICKS_APP_PORT=8000
DATABRICKS_APP_NAME=midasv2
FLASK_RUN_HOST=0.0.0.0

# --- Approval routing (feedback #3) ---
# Governed-tag key whose value is the owning group. Approvals for a table's
# changes are restricted to members of this group.
MIDAS_OWNER_TAG_KEY=owner
# Optional: a group that may approve ANY change regardless of owner group
# (e.g. a central data-governance team). Workspace admins always can.
MIDAS_ADMIN_OVERRIDE=

# --- Tier-based templates (feedback #4, DAWG 0003) ---
# Governed-tag key whose value is the DAWG 0002 data tier (0-4).
MIDAS_TIER_TAG_KEY=data_tier
